# Required
OPENAI_API_KEY=sk-...

# SMS transport: mock | saperly | twilio
SMS_TRANSPORT=mock

# Secret token for POST /game/start
GAME_START_TOKEN=change-me

# The system number shown to the human for announcements
SYSTEM_PHONE_NUMBER=+15550000000

# Public URL for Receipts links (set to your ngrok URL in prod)
BASE_URL=http://localhost:8000

# Timing between SMS sends (seconds)
SMS_SEND_DELAY=0.5

# Max exploration rounds before forcing an emergency meeting
MAX_EXPLORATION_ROUNDS=3

# Directory for grudge JSON files (long-term player memory across games)
# Set to an absolute path + mount a Docker volume in production
GRUDGE_DIR=.grudges

# --- Saperly (if SMS_TRANSPORT=saperly) ---
# SAPERLY_API_KEY=

# --- Twilio (if SMS_TRANSPORT=twilio) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_NUMBER_POOL=+15551111,+15552222,+15553333,+15554444,+15555555,+15556666,+15557777,+15558888
